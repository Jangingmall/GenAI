      "inscription_translation": null,
      "inscription_remark": null,
      "sortorder": null
    },
    {
      "inscription": "[Numbers engraved on the stand, the tureen, and the cover to show how the piece should be assembled]:\n “A nº 1” [on the base of the tureen; beneath the cover; on the platter],\n“A nº 2” [on the platter],\n“A nº 3” [on the exterior rim of the tureen],\n“A nº4”; “A nº 5” [outside the cover],\n“A nº 7” [on the border of the platter]",
