  "inscriptions": [
    {
      "inscription": "signed 碧山 and dated 乙酉年 (1345)",
      "inscription_translation": null,
      "inscription_remark": null,
      "sortorder": 1
    },
    {
      "inscription": "The inscription in seal script style (zhuanshu) reads:\n\nRaft cup, made in the yiyou year of Zhizheng [1345], Whoso wishes to reach the Milky Way is obstructed by the sky; Once there was a man, restless and valiant, who penetrated into the silver sea. Alas! Why did he not seek for some embroidery from the celestial loom? He only brought back in his arms a slab of stone used to prop up the loom.",
      "inscription_translation": null,
      "inscription_remark": null,
      "sortorder": 2
    }
  ],
