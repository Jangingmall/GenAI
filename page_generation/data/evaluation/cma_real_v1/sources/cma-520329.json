  "inscriptions": [
    {
      "inscription": "大日本清風造",
      "inscription_translation": "Inscription incised on the base: \"Made by Seifu of Great Japan\"",
      "inscription_remark": null,
      "sortorder": 1
    },
    {
      "inscription": "This gu-shaped vase has “cherry blossom glaze” (ōkayū), according to the inscription on its box.",
      "inscription_translation": "",
      "inscription_remark": null,
      "sortorder": 2
    },
    {
      "inscription": "A label affixed to the side of the box gives a sense of how previous owners conceived of the piece. Although the label is partially abraded, one can make out the character nezu 鼠, used in the names of numerous light pinks, from Naniwa pink (Osaka pink) to Miyako pink (Kyoto, or capital, pink). Also legible is the phrase hakugōrai, a broad term that can describe a shade of white associated with ceramics discovered in Korean tombs, but often applied to other ceramics of similar coloration, many from Chinese kilns, including Ding (J. Tei) ware of the Northern Song dynasty.",
      "inscription_translation": "",
      "inscription_remark": null,
      "sortorder": 3
    },
    {
      "inscription": "清風",
      "inscription_translation": "Seal on the top of the box lid: “Seifū”",
      "inscription_remark": "The storage box is also inscribed with a description of the contents of the box.",
      "sortorder": 4
    },
    {
      "inscription": "帝室技芸員",
      "inscription_translation": "Inscription on the inside of the box lid: Imperial Household Artist “Teishitsu gigei’in”",
      "inscription_remark": null,
      "sortorder": 5
    },
    {
      "inscription": "清風與平",
      "inscription_translation": "Seal on the inside of the box lid: “Seifū Yohei.”",
      "inscription_remark": null,
      "sortorder": 6
    }
  ],
