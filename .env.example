# ==============================================================================
# detail-page-ai Ubuntu 배포 환경변수 설정 파일 (.env.example)
#
# g6e.xlarge (NVIDIA L40S 48GB 1장) 기준 SGLang 3서비스(detail-page-ai,
# sglang-text, sglang-image) 공존 구성을 기본으로 합니다.
# Ubuntu 서버 배포 시 이 파일을 .env 로 복사한 뒤 실제 환경에 맞게 값을 수정하세요.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SGLang 추론 인프라 (docker-compose 컨테이너 설정)
# ------------------------------------------------------------------------------

# SGLang 공식 Docker 이미지 태그 및 버전 (L40S sm89 및 FP8 네이티브 지원)
SGLANG_IMAGE=lmsysorg/sglang:v0.5.19
SGLANG_VERSION=0.5.19

# 텍스트/비전 추론 모델 가중치 체크포인트 경로 (Hugging Face 다운로드 대상)
# [기본값: cyankiwi/Qwen3.8-27B-AWQ-INT4] (가중치 19.6 GiB, 비전 멀티모달 지원, Apache 2.0)
# - 채택 이유: L40S 48GB에서 텍스트 메모리를 ~24GB 수준으로 통제하여 확산 모델(FLUX 4B)과 공존 시 넉넉한 여유분(~21GB)을 확보함.
# - 대안: Qwen/Qwen3.8-27B-FP8 (28.77 GiB) - 텐서코어 FP8 가속에 최적이나 가중치가 48GB의 60%를 차지해 확산 모델과의 공존 여유가 12GB 미만으로 매우 타이트함.
TEXT_MODEL_PATH=cyankiwi/Qwen3.8-27B-AWQ-INT4

# 텍스트 추론 서버 공개 모델 이름 (--served-model-name 및 클라이언트 요청 model 필드)
TEXT_SERVED_MODEL_NAME=qwen-text

# 텍스트 서버 정적 VRAM 선점 비율 (48GB 중 가중치 19.6 GiB 기준 물리적 하한: 19.6 / 48 ≈ 0.41)
# 8192 컨텍스트의 기본 KV 캐시 풀을 포함하여 0.50 (약 24.0 GiB)을 초기값으로 지정합니다.
# [중요] 인스턴스에서 측정 후 확정
TEXT_MEM_FRACTION=0.50

# 텍스트 모델 최대 컨텍스트 길이 (KV 캐시 과다 할당 방지)
TEXT_CONTEXT_LENGTH=8192

# 이미지 확산 추론 모델 가중치 체크포인트 경로 (Hugging Face 다운로드 대상)
# [기본값: black-forest-labs/FLUX.2-klein-4B] (가중치 7.22 GiB, Apache 2.0 라이선스)
# - [주의] FLUX.2-klein-9B는 'FLUX Non-Commercial License(FLUX NCL)'가 적용되어 이커머스 상업 운영이 원천 불가함 (근거: https://bfl.ai/blog/flux2-klein-towards-interactive-visual-intelligence).
# - 4B는 Apache 2.0 완전 오픈 가중치로 상업적 이용이 허용되며, 4-step Rectified Flow로 단일 GPU에서 고속 생성이 가능합니다.
# - 대안(극소 VRAM): black-forest-labs/FLUX.2-klein-4b-fp8 (3.80 GiB, Apache 2.0)
IMAGE_MODEL_PATH=black-forest-labs/FLUX.2-klein-4B

# 이미지 확산 서버 공개 모델 이름 (--served-model-name 및 클라이언트 요청 model 필드와 일치 필수)
IMAGE_SERVED_MODEL_NAME=flux-klein

# SGLang 확산 엔진 성능/메모리 프리셋 (memory: 불필요한 VRAM 점유 억제)
IMAGE_PERFORMANCE_MODE=memory

# Hugging Face 액세스 토큰 (FLUX.2-klein-4B는 비게이트 저장소라 다운로드에 토큰이 불필요하나, 게이트 모델이나 비공개 체크포인트 사용 시 설정)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 2. 애플리케이션 추론 클라이언트 설정 (detail-page-ai)
# ------------------------------------------------------------------------------

# 분석 제공자 모드. local 고정이므로 변경 불필요.
ANALYSIS_PROVIDER=local

# 텍스트 분석 클라이언트 제공자 (Ubuntu SGLang 구성 시 sglang 지정, Mac 로컬 개발 시 mlx)
LOCAL_TEXT_PROVIDER=sglang

# 텍스트 모델 추론 서버 URL (compose 서비스 sglang-text 포트 30000)
LOCAL_TEXT_URL=http://sglang-text:30000

# 텍스트 모델 식별자 (TEXT_SERVED_MODEL_NAME과 100% 일치)
LOCAL_TEXT_MODEL=qwen-text

# 텍스트 분석 요청 타임아웃(초)
LOCAL_TEXT_TIMEOUT=300.0

# 이미지 생성 클라이언트 제공자 (Ubuntu SGLang 구성 시 sglang 지정, Mac 로컬 개발 시 mlx, 비활성화 시 none)
LOCAL_IMAGE_PROVIDER=sglang

# 이미지 생성 서버 URL (compose 서비스 sglang-image 포트 30001)
LOCAL_IMAGE_URL=http://sglang-image:30001

# 이미지 생성 모델 식별자 (IMAGE_SERVED_MODEL_NAME과 100% 일치)
LOCAL_IMAGE_MODEL=flux-klein

# 이미지 생성 요청 타임아웃(초)
LOCAL_IMAGE_TIMEOUT=300.0

# 제품 사진 생성 방식. source 고정이므로 변경 불필요.
PRODUCT_PHOTO_GENERATION=source

# 배경판 생성 제공자 (sglang 또는 none)
BACKGROUND_PROVIDER=sglang

# 생성 시도할 사진 역할 목록(쉼표 구분)
PRODUCT_PHOTO_SHOTS=hero,packshot,detail,lifestyle

# 원본 사진 추가 컷 파생 임계값(1~12)
SOURCE_PHOTO_VARIATION_THRESHOLD=4

# ------------------------------------------------------------------------------
# 3. 렌더러 및 상품 백엔드(Product BE) 연동
# ------------------------------------------------------------------------------

# 상세페이지 렌더러 구현체. html 고정이므로 변경 불필요.
DETAIL_PAGE_RENDERER=html

# 산출물 배달 대상 상품 백엔드 URL. 실제 Product BE 수신 주소로 반드시 설정 필요.
BACKEND_PRODUCT_URL=

# 상품 백엔드 연동 인증 토큰. 비밀값이므로 반드시 설정 필요.
BACKEND_AUTH_TOKEN=

# 상품 백엔드 호출 타임아웃(초). 기본값 유지 가능.
BACKEND_TIMEOUT_SECONDS=60.0

# Product BE가 AI 서비스를 호출할 때 검증하는 내부 인증 토큰 (X-AI-Internal-Token). 비밀값이므로 반드시 설정 필요.
AI_INTERNAL_AUTH_TOKEN=

# 커스텀 상세페이지 HTML 템플릿 경로. 미설정 시 내장 템플릿을 사용하므로 비워두기 가능.
DETAIL_PAGE_TEMPLATE_PATH=

# ------------------------------------------------------------------------------
# 4. 입력 제약 및 파이프라인 안전성
# ------------------------------------------------------------------------------

# 단일 입력 이미지 최대 바이트 크기 (기본 10MB). 기본값 유지 가능.
MAX_IMAGE_BYTES=10485760

# 입력 이미지 디코딩 검증 강제 여부 (true/false). 기본값 유지 권장.
REQUIRE_DECODABLE_IMAGES=true

# 요청당 최대 허용 소스 이미지 수 (1~50). 기본값 유지 가능.
MAX_SOURCE_IMAGES=12

# 전체 요청 본문 최대 바이트 크기 (기본 120MB). 기본값 유지 가능.
MAX_REQUEST_BYTES=125829120

# 최대 대기 가능 생성 작업 수. 서버 자원에 따라 조정 가능.
MAX_PENDING_GENERATIONS=100

# Outbox 백엔드 배달 최대 재시도 횟수 (1~100). 기본값 유지 가능.
MAX_DELIVERY_ATTEMPTS=8

# 레거시 /api/v1 데모 엔드포인트 활성화 여부. 운영 환경에서는 false 권장.
ENABLE_LEGACY_DEMO_API=false

# CORS 허용 오리진 목록(쉼표 구분). 운영 프론트엔드 도메인에 맞게 변경 필요.
AI_CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# 프롬프트 템플릿 버전 식별자. 기본값 유지.
PROMPT_VERSION=local-sglang-qwen-flux-v1

# 결과 상세페이지 에셋 반환 방식 (base64, url, both). 기본값 유지 가능.
RESPONSE_ASSET_MODE=base64

# 공예 리서치 수행 여부를 판단하는 신뢰도 임계값 (0.0~1.0). 기본값 유지 가능.
CRAFT_CONFIDENCE_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 5. 영구 볼륨 스토리지 경로 (컨테이너 내부 /var/lib/detail-page-ai 기준)
# ------------------------------------------------------------------------------

# 생성 이미지 및 소스 자산 저장 디렉터리. 컨테이너 볼륨 경로(/var/lib/detail-page-ai/assets)와 일치시킴.
ASSET_STORE_DIR=/var/lib/detail-page-ai/assets

# SQLite 작업 상태 DB 파일 경로. 컨테이너 볼륨 경로(/var/lib/detail-page-ai/state.sqlite3)와 일치시킴.
SQLITE_PATH=/var/lib/detail-page-ai/state.sqlite3

# rembg 누끼 모델(birefnet-general.onnx, 973MB) 캐시 디렉터리. 볼륨에 영구 저장되도록 지정.
U2NET_HOME=/var/lib/detail-page-ai/models/u2net
