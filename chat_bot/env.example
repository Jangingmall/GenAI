# 이 파일을 복사해 .env 로 만들고, 각자 값을 채운다.
#   cp .env.example .env
# .env 는 깃에 올리지 않는다 (.gitignore 에 포함됨)

# --- PostgreSQL ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
# Kubernetes Secret Store CSI mount. When set, this file takes precedence over
# DB_PASSWORD. The file should contain the password with an optional trailing newline.
DB_PASSWORD_FILE=/mnt/secrets-store/password
DB_PASSWORD=

# --- LLM backend ---
LLM_BACKEND=sglang
OLLAMA_HOST=
SGLANG_HOST=
MLX_SERVE_HOST=
LLM_MODEL=

# --- 임베딩 ---
EMBED_MODEL=/models/bge-m3
EMBED_DIM=
